# Copie para .env e preencha. O .env NÃO vai pro git (.gitignore já cobre .env*).

# ---- Deploy / acesso (Caddy) ----
CLIPFORGE_DOMAIN=clipforge.seudominio.com.br
BASIC_AUTH_USER=admin
# Gere o hash (NÃO ponha a senha em texto puro):
#   docker run --rm caddy:2 caddy hash-password --plaintext 'suaSenhaForte'
BASIC_AUTH_HASH=$2a$14$troque_pelo_hash_gerado

# ---- LLM (roteiro) — obrigatório pro caminho de IA ----
CLIPFORGE_LLM_BASE_URL=https://api.seuprovedor.com/v1
CLIPFORGE_LLM_API_KEY=sk-xxxxxxxx
CLIPFORGE_LLM_MODEL=deepseek-chat

# ---- Bancos de imagem opcionais (o caminho grátis funciona sem estes) ----
# CLIPFORGE_PEXELS_KEY=
# CLIPFORGE_PIXABAY_KEY=
